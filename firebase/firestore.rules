rules_version = '2';

// Reglas de acceso de Firestore.
//
// Postura: DENEGAR POR DEFECTO. Ninguna coleccion es legible ni escribible
// salvo por concesion explicita.
//
// **Aqui vive la puerta de consentimiento** (decision D1 de la feature 004).
// No en la pantalla: una puerta que solo comprueba el cliente no es una
// puerta, es una cortesia. El cliente la comprueba tambien, para no enviar lo
// que va a rebotar y para explicarselo al nadador, pero quien la hace cumplir
// es este archivo.
//
// La decision de quien puede que esta escrita aqui esta escrita tambien en
// `lib/dominio/cuentas/permisos.dart`, del lado del cliente. Que las dos
// coincidan lo vigila `test/acceso/casos.json`, que las dos suites recorren
// (garantia A10).
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Quien eres ----------------------------------------------------

    function autenticado() {
      return request.auth != null;
    }

    // El rol viaja dentro del token, firmado por el Admin SDK. Un cliente no
    // puede alterarlo (decision D2). Si esta cadena cambia, cambia tambien en
    // `Rol.clave` de lib/dominio/cuentas/cuenta.dart el mismo dia.
    function rol() {
      return autenticado() ? request.auth.token.get('rol', '') : '';
    }

    function esEntrenador() {
      return rol() == 'entrenador';
    }

    function esNadador() {
      return rol() == 'nadador';
    }

    // A que perfil de nadador corresponde la cuenta. Vive en un documento y no
    // en el token porque es un dato que cambia y no tiene por que viajar en
    // cada peticion.
    function miNadadorId() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        .data.get('nadadorId', '');
    }

    function soyEseNadador(nadadorId) {
      return esNadador()
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && miNadadorId() == nadadorId;
    }

    // --- La puerta de consentimiento ------------------------------------

    // Un nadador menor sin consentimiento vigente no tiene datos aqui. Lo que
    // escriba se queda en su dispositivo, en la bandeja de salida, hasta que
    // su acudiente consienta. No queda bloqueado: queda retenido.
    //
    // Cuesta una lectura por escritura. A esta escala —decenas de nadadores—
    // es irrelevante, y desnormalizarlo para ahorrarla crearia la posibilidad
    // de que el estado de la puerta discrepe de si mismo en dos sitios.
    function tieneConsentimientoVigente(nadadorId) {
      return exists(/databases/$(database)/documents/consentimientos/$(nadadorId))
          && get(/databases/$(database)/documents/consentimientos/$(nadadorId))
               .data.get('vigente', false) == true;
    }

    // --- Planes ---------------------------------------------------------

    // Un plan aprobado o publicado es inmutable (FR-025). Ni el entrenador
    // puede escribir sobre el: editarlo crea una version nueva.
    function estadoEsInmutable(estado) {
      return estado == 'aprobado' || estado == 'publicado';
    }

    function planExistenteEsInmutable() {
      return resource != null && estadoEsInmutable(resource.data.estado);
    }

    // Lo que un nadador ve: solo lo publicado y asignado a el.
    //
    // Las tres condiciones importan por separado. Un borrador no es de nadie
    // todavia; un aprobado esta firmado pero no entregado —aprobar no es
    // entregar—; uno publicado sin asignar no es de este nadador.
    function planEsDelNadador() {
      return resource.data.estado == 'publicado'
          && resource.data.get('nadadoresIds', []).hasAny([miNadadorId()]);
    }

    match /planes/{planId} {
      allow read: if esEntrenador()
                  || (esNadador()
                      && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
                      && planEsDelNadador());

      // Crear: solo el entrenador, y solo en estado borrador.
      allow create: if esEntrenador()
                    && request.resource.data.estado == 'borrador';

      // Actualizar: solo el entrenador, y nunca sobre un plan ya aprobado o
      // publicado. Un nadador no mueve un plan a ningun estado (principio IV).
      allow update: if esEntrenador() && !planExistenteEsInmutable();

      allow delete: if esEntrenador() && !planExistenteEsInmutable();

      // Sesiones del plan: se leen con el plan y se escriben con el plan.
      match /sesiones/{sesionId} {
        function elPlan() {
          return get(/databases/$(database)/documents/planes/$(planId)).data;
        }

        allow read: if esEntrenador()
                    || (esNadador()
                        && elPlan().estado == 'publicado'
                        && elPlan().get('nadadoresIds', []).hasAny([miNadadorId()]));

        allow write: if esEntrenador() && !estadoEsInmutable(elPlan().estado);
      }
    }

    // --- Nadadores ------------------------------------------------------

    match /nadadores/{nadadorId} {
      allow read: if esEntrenador() || soyEseNadador(nadadorId);
      allow write: if esEntrenador();
    }

    // --- Registros del nadador ------------------------------------------
    //
    // La respuesta del nadador a una sesion. Coleccion aparte del plan a
    // proposito: un plan aprobado es inmutable y lo que el nadador escribe no
    // lo toca.
    //
    // La feature 003 dejo aqui una limitacion declarada: las reglas no
    // distinguian a un nadador de otro porque no habia identidad. Queda
    // cerrada. No hizo falta migrar nada, porque cada registro ya llevaba su
    // nadadorId.
    match /registros/{registroId} {
      // El entrenador lee los de su comunidad. **No los escribe**: lo que el
      // nadador responde es su carga interna, no la del entrenador. Es un
      // cambio deliberado respecto de la 003, donde era lo unico permitido.
      allow read: if esEntrenador() || soyEseNadador(resource.data.nadadorId);

      allow create: if soyEseNadador(request.resource.data.nadadorId)
                    && tieneConsentimientoVigente(request.resource.data.nadadorId);

      allow update: if soyEseNadador(resource.data.nadadorId)
                    && soyEseNadador(request.resource.data.nadadorId)
                    && tieneConsentimientoVigente(resource.data.nadadorId);

      // Un registro no se borra desde el cliente. El derecho al borrado del
      // principio V se ejerce por la via del servidor, que puede dejar
      // constancia de que se ejercio.
      allow delete: if false;
    }

    // --- Consentimientos y solicitudes -----------------------------------
    //
    // **Ninguna escritura del cliente.** Ni la del entrenador. La fecha la
    // pone el servidor (D5) y el canje lo hace el servidor (D4); si el cliente
    // pudiera escribir aqui, las dos garantias serian declaraciones suyas.
    match /consentimientos/{nadadorId} {
      allow read: if esEntrenador() || soyEseNadador(nadadorId);
      allow write: if false;

      match /historial/{consentimientoId} {
        allow read: if esEntrenador() || soyEseNadador(nadadorId);
        allow write: if false;
      }
    }

    match /solicitudes/{solicitudId} {
      // El entrenador ve en que estado va. El token en claro no esta aqui:
      // solo su resumen, asi que leer esta coleccion no permite fabricar un
      // enlace valido (garantia C4).
      allow read: if esEntrenador();
      allow write: if false;
    }

    // --- Vinculo cuenta <-> perfil de nadador ----------------------------

    match /usuarios/{uid} {
      allow read: if esEntrenador() || (autenticado() && request.auth.uid == uid);
      // Lo escribe el servidor al asociar un perfil. Si el cliente pudiera,
      // cualquiera se declararia dueno del perfil de otro y leeria sus planes.
      allow write: if false;
    }

    // --- Propuestas de ejercicio y glosario -----------------------------

    match /propuestasEjercicio/{propuestaId} {
      allow read, write: if esEntrenador();
    }

    match /glosario/{terminoId} {
      allow read, write: if esEntrenador();
    }

    // --- Todo lo demas --------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
